---
import Layout from '../layouts/Layout.astro';
import DocumentList from '../components/DocumentList.astro';
import { documents, categories, BASE } from '../lib/content.mjs';
---
<Layout>
  <section class="page-intro"><span class="eyebrow">TODAY I LEARNED</span><h1>배움의 기록.</h1><p>데이터, 클라우드, 그리고 시스템.<br/>이해한 것을 글로 남기고 다시 연결합니다.</p><a class="intro-search" href={BASE + 'search/'}>어떤 기록을 찾고 있나요?<span aria-hidden="true">→</span></a></section>
  <section aria-labelledby="list-title"><div class="section-heading"><h2 id="list-title">모든 기록 <span>{documents.length}</span></h2><span>{categories.length}개 주제 · 최근 수정 순</span></div><DocumentList documents={documents} /></section>
</Layout>
